# Graffiticode API + auth service (defaults shown)
NEXT_PUBLIC_GC_API_URL=https://api.graffiticode.org
NEXT_PUBLIC_GC_AUTH_URL=https://auth.graffiticode.org

# Privy (email magic-link sign-in). Get from the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# Firebase Web API key for the graffiticode auth project — used server-side to
# exchange a Graffiticode api key for a Firebase ID token (api-credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=

# The installation's application storage (core/src/storage.ts): required, with
# no built-in default. Or set PROFILE_DIR to an installation profile, which
# states its project and database.
GOOGLE_CLOUD_PROJECT=

# Firebase Admin credentials for that project. Point at a service-account JSON.
# On Cloud Run this is provided by the runtime service account instead. With the
# Firestore emulator (FIRESTORE_EMULATOR_HOST), none is needed.
GOOGLE_APPLICATION_CREDENTIALS=
