  "services": [
    {
      "serviceId": "learnosity-assessment-authoring",
      "version": 1,
      "name": "Learnosity Assessment Authoring",
      "responsibility": "Create and revise assessment content, validate it, provide previews, and (when enabled) save an explicitly selected revision through an authorized connection.",
      "exclusions": [
        "learner delivery",
        "reporting",
        "bulk data operations",
        "unrestricted item bank administration"
      ],
      "limits": {
        "deadlineMs": 2700000,
        "retryWindowMs": 2592000000,
        "maxGenerationAttempts": 3
      },
      "skills": [
        {
          "skillId": "author_content",
          "name": "Author assessment content",
          "description": "Create or revise Learnosity questions, scoring, feedback and activities, validated and previewable. Never writes to an item bank.",
          "capability": "generate-content",
          "deliverableKind": "content",
          "deliveryStates": [
            "prepared",
            "previewed"
          ],
          "languages": [
            "0176"
          ],
          "examples": [
            "Five multiple-choice questions on photosynthesis for grade 7, with feedback."
          ],
          "tools": [
            {
              "operation": "create",
              "name": "assessment_create_item"
            },
            {
              "operation": "revise",
              "name": "assessment_update_item"
            }
          ]
        },
        {
          "skillId": "plan_authoring_integration",
          "name": "Plan an authoring integration",
          "description": "A host-neutral recipe for embedding Learnosity's authoring UI. Requires real deployment facts.",
          "capability": "generate-content",
          "deliverableKind": "integration_recipe",
          "deliveryStates": [
            "prepared"
          ],
          "languages": [
            "0177"
          ],
          "examples": [
            "How do I embed the item editor restricted to multiple-choice questions?"
          ],
          "tools": [
            {
              "operation": "create",
              "name": "authoring_integration_plan"
            }
          ]
        }
      ]
    },
    {
      "serviceId": "learnosity-data-operations",
      "version": 1,
      "name": "Learnosity Data Operations",
      "responsibility": "Plan, and when enabled execute, bounded reads, exports, transformations and migrations of assessment records.",
      "exclusions": [
        "content authoring",
        "learner delivery",
        "unbounded administration"
      ],
      "limits": {
        "deadlineMs": 2700000,
        "retryWindowMs": 2592000000,
        "maxGenerationAttempts": 3
      },
      "skills": [
        {
          "skillId": "plan_data_job",
          "name": "Plan a data job",
          "description": "A plan for a Learnosity Data API job (a read, export or migration): the operation, prerequisites, paging, write semantics, gotchas and verification. No live provider operation occurs.",
          "capability": "generate-content",
          "deliverableKind": "data_plan",
          "deliveryStates": [
            "planned"
          ],
          "languages": [
            "0178"
          ],
          "examples": [
            "Plan an export of all sessions for activity X, all pages."
          ],
          "tools": [
            {
              "operation": "create",
              "name": "data_plan"
            }
          ]
        }
      ]
    }
  ]
}
