{
  "name": "@graffiticode-app/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Graffiticode - multi-language DSL platform",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node scripts/build-widget.mjs",
    "build:widget": "node scripts/build-widget.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:widget": "tsc -p tsconfig.widget.json",
    "test": "npm run build && npm run typecheck:widget && FREE_PLAN_NAMESPACE_SALT=test-salt-not-a-real-secret tsx --test tests/*.test.ts",
    "clean": "rimraf dist",
    "eval:routing": "npx tsx scripts/eval-routing.ts",
    "eval:fit": "npx tsx scripts/eval-fit.ts",
    "start": "node dist/server.js",
    "gcp:build": "gcloud builds submit --project graffiticode-app --config cloudbuild.yaml --substitutions=COMMIT_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo 'latest')",
    "gcp:deploy": "gcloud run deploy mcp-service --project graffiticode-app --source . --port 3001 --region us-central1 --platform managed --allow-unauthenticated",
    "gcp:logs": "gcloud run services logs read mcp-service --project graffiticode-app --region us-central1"
  },
  "dependencies": {
    "@graffiticode/l0000-view": "^0.3.0",
    "@graffiticode/l0185-view": "^0.1.0",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jose": "^4.15.9"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@graffiticode/l0014-view": "^0.1.0",
    "@graffiticode/l0159": "^0.3.1",
    "@graffiticode/l0166": "^0.1.6",
    "@graffiticode/l0170": "^0.1.0",
    "@graffiticode/l0173": "^0.1.0",
    "@graffiticode/l0175-view": "^0.1.0",
    "@graffiticode/l0176-view": "^0.1.0",
    "@graffiticode/l0177-view": "^0.1.0",
    "@graffiticode/l0178-view": "^0.1.0",
    "@graffiticode/l0179-view": "^0.3.4",
    "@graffiticode/l0180-view": "^0.2.0",
    "@graffiticode/l0181-view": "^0.1.0",
    "@graffiticode/l0182-view": "^0.1.0",
    "@graffiticode/l0183-view": "^0.3.0",
    "@graffiticode/l0184-view": "^0.2.1",
    "@graffiticode/l0186-view": "^0.2.0",
    "@types/node": "^20.10.0",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.5",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "graffiticode",
    "mcp",
    "dsl",
    "spreadsheets",
    "charts",
    "forms"
  ],
  "author": "Artcompiler",
  "license": "MIT",
  "private": true
}
