**/node_modules/
**/npm-debug.log

**/.git
**/README.md

**/.vscode
**/.env
**/.editorconfig

**/.gc-deploy
**/.env*
**/*.key
**/*.pem

# tsc output is built inside each image (multi-stage) and copied in
# explicitly; never ship a local or Cloud Build workspace build.
**/dist
**/*.tsbuildinfo
**/.compiled-test
**/.next

# The release's installation profile: every byte counts in its digest, which
# the candidate reports and gc-deploy checks (README.md and .env* included), so
# none of the patterns above may drop any of it. Keep these lines last.
!.gc-profile
!.gc-profile/**
